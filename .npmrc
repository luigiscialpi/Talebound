# React Native / Metro non supportano i symlink di pnpm:
# node-linker=hoisted crea un node_modules piatto compatibile con Metro.
node-linker=hoisted
# Garantisce che le dipendenze native vengano risolte alla root.
shamefully-hoist=true
# Usa sempre la versione di pnpm dichiarata in package.json (packageManager).
auto-install-peers=true
