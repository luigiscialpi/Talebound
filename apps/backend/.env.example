# Backend — copia in .env e compila con i tuoi valori.
# NON committare mai il file .env reale.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Sicurezza
HMAC_SECRET=change-me-with-at-least-32-characters

# Opzionali
REDIS_URL=
SLACK_WEBHOOK_URL=
MAX_INPUT_LENGTH=500
CLASSIFIER_TIMEOUT_MS=300
PORT=3000
