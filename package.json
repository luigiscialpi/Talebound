{
  "name": "talebound",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @talebound/mobile dev",
    "android": "pnpm --filter @talebound/mobile android",
    "backend:dev": "pnpm --filter @talebound/backend dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "emulator:list": "$ANDROID_HOME/emulator/emulator -list-avds",
    "emulator": "$ANDROID_HOME/emulator/emulator -avd Pixel_8_API_32 &",
    "android:boot-wait": "$ANDROID_HOME/platform-tools/adb wait-for-device shell 'while [ -z \"$(getprop sys.boot_completed)\" ]; do sleep 2; done && echo emulator ready'",
    "android:dev": "pnpm emulator && pnpm android:boot-wait && pnpm android",
    "health": "bash scripts/healthcheck.sh",
    "health:android": "bash scripts/healthcheck.sh --android"
  }
}
